# Ignore Python virtual environments
venv/
env/
.venv/

# Ignore Python cache files
__pycache__/
*.py[cod]
*$py.class

# Ignore Windows system files
Thumbs.db
desktop.ini

# Ignore IDE configuration folders (if you use VS Code)
.vscode/

# Ignore build artifacts
*.whl
build/
dist/
*.egg-info/

# SSL certificates (sensitive)
cert.pem
key.pem
*.pem

# Jupyter notebooks
.ipynb_checkpoints/