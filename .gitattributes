# Ensure all Python and shell scripts always use LF line endings on every platform.
# This prevents Windows from introducing CRLF or null bytes into source files,
# which causes SyntaxError ("source code string cannot contain null bytes") on Linux.
*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.css   text eol=lf
